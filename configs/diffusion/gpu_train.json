    "intraop_threads": 2
  },
  "cache": {
    "train_limit": null,
    "val_limit": null
  },
  "sampling": {
    "ddim_steps": 50,
    "later_check_steps": [50, 100],
    "guidance": 1.0,
    "max_targets": 8,
    "proposals_per_target": 8
  }
